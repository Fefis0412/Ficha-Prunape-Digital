# Copiá este archivo a .env.local:
#     cp .env.example .env.local
#
# Estos valores ya sirven para el Supabase LOCAL (npx supabase start).
# La clave de abajo es la misma en toda instalación local de Supabase: es
# pública y no protege nada. Para producción, reemplazá ambos valores por
# los de tu proyecto (Project Settings → API).

# Ruta relativa: la API se sirve por el mismo origen a través del proxy de
# vite. Funciona igual en localhost, por IP de red y detrás de un túnel.
# Para producción, poné acá la URL completa de tu proyecto de Supabase.
VITE_SUPABASE_URL=/api-supabase
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# La clave de servicio (service_role) NO va acá ni en el repositorio.
# Solo se usa desde scripts/sembrar.mjs, que la toma del entorno.
